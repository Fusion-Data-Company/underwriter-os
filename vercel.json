{
  "buildCommand": "npm run build",
  "outputDirectory": "web",
  "headers": [
    {
      "source": "/configuration.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
